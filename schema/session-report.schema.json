{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mturac/InferShape/schema/session-report.schema.json",
  "title": "InferShape session report",
  "type": "object",
  "required": ["schemaVersion", "kind", "summary", "metrics", "findings", "profileHash", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "kind": { "const": "infershape.session-report" },
    "summary": { "type": "object" },
    "metrics": { "type": "object" },
    "findings": { "type": "array" },
    "profileHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
