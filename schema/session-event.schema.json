{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mturac/InferShape/schema/session-event.schema.json",
  "title": "InferShape generic coding-agent session event",
  "type": "object",
  "required": ["timestamp", "type"],
  "properties": {
    "timestamp": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "number" }] },
    "type": {
      "enum": ["session_start", "objective", "file_read", "file_write", "file_delete", "search", "command_start", "command_end", "test_run", "tool_call", "tool_result", "completion_claim", "verification", "session_end", "unknown"]
    },
    "session_id": { "type": "string", "minLength": 1 },
    "path": { "type": "string" },
    "command": { "type": "string" },
    "outcome": { "enum": ["success", "failure", "cancelled", "unknown"] },
    "exit_code": { "type": "integer" },
    "duration_ms": { "type": "number", "minimum": 0 },
    "content_hash": { "type": "string" },
    "test_scope": { "enum": ["focused", "full", "unknown"] },
    "objective": { "type": "string" },
    "scope_paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "claim": { "enum": ["done", "partial", "blocked", "unknown"] }
  },
  "additionalProperties": true
}
